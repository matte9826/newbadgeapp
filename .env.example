# Copy this file to .env and fill in your values. The real .env is git-ignored.

COMPANY_NAME=The Secret Garden

# Database (Supabase / Postgres). Use the Supabase "Connection Pooling" string
# (Transaction mode, port 6543) — required on Vercel. Leave empty to run the app
# without a database (pages load, but data actions return "non configurato").
# Example: postgresql://postgres.abcdxyz:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Set to "disable" ONLY for a local Postgres without TLS. Leave empty for Supabase.
DATABASE_SSL=

# Admin (HR manager) credentials. The password is never stored in plain text:
# on startup the server hashes it and seeds/updates the single admin account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Secret used to sign session cookies (JWT). Leave empty to auto-generate and
# persist one in data/.jwt_secret. In production set a long random value here.
JWT_SECRET=

PORT=3000

# Use "production" when serving over HTTPS so session cookies get the Secure flag.
NODE_ENV=development
